{
  "name": "sneaker-drop",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node init && concurrently -n api,socket,web -c blue,magenta,green \"npm:dev -w @sneaker-drop/api\" \"npm:dev -w @sneaker-drop/socket\" \"npm:dev -w @sneaker-drop/web\"",
    "dev:api": "node init && npm run dev -w @sneaker-drop/api",
    "dev:socket": "node init && npm run dev -w @sneaker-drop/socket",
    "dev:web": "node init && npm run dev -w @sneaker-drop/web",
    "build:web": "node init && npm run build -w @sneaker-drop/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
